<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ferret.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/REPLACE_WITH_ABSOLUTE_PATH/ferret/ferret.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/REPLACE_WITH_ABSOLUTE_PATH/ferret</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/REPLACE_WITH_ABSOLUTE_PATH/ferret/logs/ferret.log</string>
  <key>StandardErrorPath</key>
  <string>/REPLACE_WITH_ABSOLUTE_PATH/ferret/logs/ferret.error.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
