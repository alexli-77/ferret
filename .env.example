# Discord bot credentials
# Create a bot at https://discord.com/developers/applications
# Invite it to your server with `Send Messages` permission, then paste the token below
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID where the daily report will be posted
# Enable Developer Mode in Discord → right-click channel → Copy Channel ID
DISCORD_CHANNEL_ID=000000000000000000

# Optional: override the timezone shown in the report header (default: system local)
# TIMEZONE=America/Toronto
